{
  "enabled": true,
  "network": {
    "allowNetwork": true,
    "allowLocalBinding": true,
    "allowAllUnixSockets": false,
    "allowUnixSockets": [],
    "allowedDomains": [],
    "deniedDomains": []
  },
  "shell": {
    "readAccess": "policy"
  },
  "filesystem": {
    "denyRead": [
      "/home"
    ],
    "allowRead": [
      ".",
      "/dev/null",
      "/tmp",
      "~/.cache",
      "~/.cargo",
      "~/.rustup",
      "~/.local/share/npm-global",
      "~/.config/go",
      "~/.local/share/go",
      "~/.local/share/chrome-devtools-mcp",
      "~/.pi/agent/skills",
      "~/.npmrc",
      "~/.npm"
    ],
    "allowWrite": [
      ".",
      "/dev/null",
      "/tmp",
      "~/.cache",
      "~/.cargo",
      "~/.rustup",
      "~/.config/go",
      "~/.local/share/go",
      "~/.local/share/chrome-devtools-mcp",
      "~/.npmrc",
      "~/.npm"
    ],
    "denyWrite": []
  }
}